# 复制为 .env 后填写（.env 勿提交 Git）
# 示例项目默认使用 H2，以下变量供接入 MySQL / Redis / GitHub MCP 时使用

# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/skyworkshop
# SPRING_DATASOURCE_USERNAME=skyworkshop
# SPRING_DATASOURCE_PASSWORD=

# REDIS_HOST=localhost
# REDIS_PORT=6379

# GitHub MCP（.cursor/mcp.json 引用 ${GITHUB_TOKEN}）
# 复制本文件为 .env 后填写；Cursor 重启后 MCP 生效
GITHUB_TOKEN=
